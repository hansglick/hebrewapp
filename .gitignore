# Media (images/voice) - too heavy for git history, handled separately via
# the Render persistent disk (cf. render.yaml) - EXCEPT images_concept/,
# light enough (79MB/159 files) to just ship through git; app/main.py seeds
# the persistent disk from it on startup if missing.
backend/results/*
!backend/results/images_concept/

# Sources PDF de travail hors ligne - pas utilisées par l'app, juste lourdes
backend/data/pdfs/

# Runtime user data (SQLite DB) - local state, not source
backend/**/*.sqlite3

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Env / secrets
.env
.env.*
!.env.example

# Node
node_modules/
dist/
dist-ssr/
*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.claude/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
